RUNNER_API_TOKEN=replace-with-a-long-random-token
APP_PASSWORD_HASH='scrypt-v1$generated-by-npm-run-generate-auth'
APP_SESSION_SECRET='generated-by-npm-run-generate-auth'
APP_TOKEN_TTL_SECONDS=900
APP_ORIGINS=https://your-pwa.onrender.com,http://localhost:3000
WORKSPACE_ROOT=/absolute/path/to/workspaces
HOST=127.0.0.1
PORT=4000
DATABASE_PATH=./data/command-center.sqlite
CODEX_BIN=codex
CODEX_MODELS=gpt-5-codex
CODEX_MODEL=gpt-5-codex
CODEX_REASONING_LEVELS=low,medium,high
CODEX_REASONING_EFFORT=medium
CLAUDE_BIN=claude
CLAUDE_MODELS=sonnet,opus,haiku
CLAUDE_MODEL=sonnet
CLAUDE_REASONING_LEVELS=low,medium,high,xhigh,max
CLAUDE_REASONING_EFFORT=medium
RUNS_ROOT=./data/runs
JOB_TIMEOUT_MS=1800000
JOB_KILL_GRACE_MS=5000
MAINTENANCE_INTERVAL_MS=43200000
TERMINAL_GRACE_PERIOD_MS=86400000
FAILED_RETENTION_MS=604800000
DISK_WARNING_THRESHOLD=0.85
CLEANUP_BATCH_LIMIT=50
BACKEND_DEPLOY_REPOSITORY_PATH=/absolute/path/to/remote-coder-backend
DEPLOYMENT_API_TOKEN=replace-with-a-separate-long-random-token
REPOSITORY_ENV_KEY_PATH=/etc/remote-coder/repository-env.key
