{
  "name": "remote-engineering-command-center-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "generate:auth": "node --import tsx src/generate-auth-secrets.ts",
    "generate:env-key": "node --import tsx src/generate-environment-key.ts",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.test.json && NODE_ENV=test node --test .test-dist/test/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
